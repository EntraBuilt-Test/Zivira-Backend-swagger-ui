{
  "name": "zivira-admin-swagger-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Zivira Labs backend API (admin, manager, field, HR/ESS, superadmin) for the Zivira Admin portal — ported from Zivira-Backend-main so this Render service (previously the Swagger-UI demo API) now runs the real implementation.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "seed:10": "tsx scripts/seed-exact-10.ts"
  },
  "dependencies": {
    "@zivira/types": "file:./packages/types",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.16",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/swagger-ui-express": "^4.1.7",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20"
  }
}
