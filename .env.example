# Zivira Labs backend — real implementation (ported from Zivira-Backend-main)
# running on this Render service.

# Render provides its own port via $PORT for most runtimes, but this app
# reads API_PORT specifically — set it to match whatever Render expects for
# this service (check the existing working zivira-backend-7qkt deployment's
# env vars for the value that's already proven to work there).
API_PORT=4000

# Your MongoDB Atlas connection string (the demo_datas cluster credentials
# you gave earlier), pointed at whichever database name you want this
# service to use.
MONGODB_URI=mongodb+srv://ziviralab_db_user:RUTddAhveSbzaZ01@demo-datas.pdh1sfq.mongodb.net/demo_datas?retryWrites=true&w=majority

# Used to sign login tokens. Set a long random value.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated extra allowed origins, on top of the zivira*.vercel.app
# pattern config.ts already allows automatically. CORS only matters for
# direct browser calls — the deployed admin frontend proxies through its
# own /api/backend/[...path] server route, which isn't subject to CORS —
# but set this if any other client calls this API directly from a browser.
CORS_ORIGINS=https://updated-zivira-admin.vercel.app

# Protects POST /api/seed/run, /api/seed/exact-10, /api/seed/fix-data, and
# similar one-off seed endpoints — required since Render's free tier has no
# shell access to run seed scripts directly. Set a long random value.
SEED_SECRET=replace-with-a-long-random-secret

# Hours after which an unapproved DCR auto-approves (src/jobs/auto-approve.job.ts).
AUTO_APPROVE_HOURS=24

# Optional — only needed if you want the manager-digest / notification
# emails (src/utils/notify.ts) to actually send. Leave unset to disable
# email sending without breaking anything else.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Zivira Labs
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ZIVIRA_HR_PORTAL_URL=
